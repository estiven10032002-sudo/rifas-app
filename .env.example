# Copia este archivo como .env.local (para uso en tu computador)
# y pega estos mismos dos valores en Vercel (Settings > Environment Variables).
#
# Los encuentras en Supabase: Project Settings > API Keys / Data API.
# Ambos valores son PÚBLICOS por diseño: la seguridad la da la base de datos (RLS).
# NUNCA pegues aquí la "service_role" / "secret" key.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable
